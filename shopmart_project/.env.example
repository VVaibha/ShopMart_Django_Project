# Copy this file to ".env" and fill in real values.
# Locally you can leave everything as-is (defaults work with SQLite).

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave blank locally (SQLite is used automatically).
# On Render/Railway, set this to the Postgres connection string they give you:
# DATABASE_URL=postgres://user:password@host:5432/dbname
